// ProofGate's own curated mutation list — the defects that would actually hurt, one sentence each.
// Run:   node skills/proofgate/scripts/mutate.mjs --list tests/mutations.jsonl -- bash tests/run-tests.sh
// (≈100 s per mutation: slice it with --slice i/n.) Every defect fixed here gains a line.
{"file": "skills/proofgate/scripts/lib.sh", "from": "if \\$v == null then empty else \\$v end", "to": "if \\$v == null or \\$v == false then empty else \\$v end", "hurts": "a configured false reads as absent again — the documented pushGuard:false switch stops working and the push guard blocks forever"}
{"file": "skills/proofgate/scripts/upstream.sh", "from": "$1 == \"diverged\" && $4 != \"behind\" { print $2 \"\\t\" $3 }", "to": "$1 == \"diverged\" { print $2 \"\\t\" $3 }", "hurts": "an upgrade refuses to update a file nobody here touched, so the project silently stays on old guards"}
{"file": "skills/proofgate/scripts/upstream.sh", "from": "$1 == \"local-only\" { print $2 \"\\t-\" }", "to": "$1 == \"local-only-x\" { print $2 \"\\t-\" }", "hurts": "an upgrade erases the guards that exist only in the project — the lesson dies on the next install, which is the original scar"}
{"file": "skills/proofgate/scripts/upstream.sh", "from": "if (lk[$2] == $3) dir = \"behind\"", "to": "if (lk[$2] == $3) dir = \"ahead\"", "hurts": "diff calls an untouched, outdated file 'ahead' and tells the owner to send upstream a copy of upstream's own old version"}
{"file": "skills/proofgate/scripts/guards.d/88-mutation.sh", "from": "if [ \"$2\" = 1 ]; then FAILED=1; else WARNED=1; fi", "to": "if [ \"$2\" = 1 ]; then FAILED=0; else WARNED=1; fi", "hurts": "a FAIL is downgraded to a warning — a mutation anchor that cannot be planted stops blocking the gate"}
{"file": "skills/proofgate/scripts/mutate-list.mjs", "from": "r.status === null || r.status === 126 || r.status === 127", "to": "r.status === null", "hurts": "a suite command that is not found reads as FAILED, i.e. every defect is declared caught by a suite that never ran"}
{"file": "skills/proofgate/scripts/mutate-list.mjs", "from": "hits === 0 ? \"obsolete\" : hits > 1 ? \"ambiguous\" : \"ok\"", "to": "hits === 0 ? \"obsolete\" : \"ok\"", "hurts": "an ambiguous anchor is planted in the first place only and the report says nothing about the other occurrence"}
{"file": "skills/proofgate/scripts/mutate-list.mjs", "from": "first === \"unmeasured\" ? measure(dir) : first", "to": "first", "hurts": "one disputed, killed run turns a protected rule into an unmeasured one and fails the delivery on machine noise"}
{"file": "install.sh", "from": "if [ \"$counterpart\" != \"-\" ] && [ \"$counterpart\" != \"$rel\" ]; then rm -f \"${DEST:?}/${counterpart:?}\"; fi", "to": ":", "hurts": "a kept guard and upstream's renumbered copy both stay installed, so the same guard runs — and is counted — twice"}
{"file": "skills/proofgate/scripts/guards.d/45-broad-process-kill.sh", "from": "pg_scan broad-process-kill \"$BROAD\" ':(exclude)*.md'", "to": "pg_scan broad-process-kill \"$BROAD\"", "hurts": "a runbook that warns against pkill is flagged as if it were the sin, and a guard that cries wolf on documentation gets switched off by the first person it annoys"}
{"file": "skills/proofgate/scripts/guards.d/47-unquoted-globstar.sh", "from": "grep -Eq -- \"$QUOTED\" && continue", "to": "grep -Eq -- \"$QUOTED\" && true", "hurts": "a script that already quotes its glob is flagged anyway, so the warning cannot be satisfied by the fix it asks for and gets switched off"}
{"file": "skills/proofgate/scripts/guards.d/47-unquoted-globstar.sh", "from": "case \"$file\" in *package.json) ;; *) continue ;; esac", "to": "case \"$file\" in *) ;; esac", "hurts": "every JSON file with a ** in a string is flagged — tool configs carry glob patterns that are not shell arguments — and the guard drowns in false positives"}
